---
import { PERSONAL_SITE_URL } from "../../site.config.mjs";
import "../styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { Icon } from "astro-icon/components";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  canonical?: string;
  tags?: string[];
  includeOutfitFont?: boolean;
}

const {
  title = "kraft",
  description = "A public lab of interactive demos and UI experiments by Reza Augusdi.",
  ogType = "website",
  ogImage = "/og.png",
  canonical,
  tags = [],
  includeOutfitFont = false,
} = Astro.props;

const SITE = Astro.site!;
const SITE_NAME = "kraft";

const resolvedTitle = title === "kraft" ? "kraft" : `${title} · kraft`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE).href;
const ogImageUrl = new URL(ogImage, SITE).href;

const pathname = Astro.url.pathname;

function isActive(href: string) {
  return href === "/"
    ? pathname === "/"
    : pathname === href || pathname.startsWith(href + "/");
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ogType === "article" ? "SoftwareApplication" : "WebSite",
  name: resolvedTitle,
  url: canonicalUrl,
  description,
  author: {
    "@type": "Person",
    name: "Reza Fauzi Augusdi",
    url: PERSONAL_SITE_URL,
  },
};
---

<!doctype html>
<html lang="en" data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary -->
    <title>{resolvedTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:creator" content="@rzaugusdi" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/kraft-mark.png" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" preload />
    {includeOutfitFont && <Font cssVariable="--font-outfit" preload />}
    <ClientRouter />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem("kraft-mode");
        const mode = stored || "dark";
        document.documentElement.setAttribute("data-mode", mode);
      })();
    </script>
  </head>

  <body>
    <div id="page-progress" aria-hidden="true" transition:persist></div>
    <div class="shell">
      <!-- Flat top bar header -->
      <header class="hdr" transition:persist>
        <div class="hdr-inner">
          <a href="/" class="hdr-brand">
            <img
              class="brand-mark"
              src="/kraft-mark.png"
              width="32"
              height="32"
              alt=""
            />
            kraft
          </a>
          <nav class="hdr-nav" aria-label="Main navigation">
            <a href="/#experiments">Experiments</a>
            <a
              href="https://github.com/fbtwitter/kraft"
              class="nav-source"
              target="_blank"
              rel="noopener noreferrer">GitHub ↗</a
            >
          </nav>
          <div class="hdr-actions">
            <a
              href={PERSONAL_SITE_URL}
              class="hdr-btn personal-site"
              aria-label="Personal site"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="lucide:arrow-up-right" size={13} />
            </a>
            <button
              class="hdr-btn"
              id="mode-toggle"
              aria-label="Dark mode"
              aria-pressed="false"
              title="Dark mode is off"
            >
              <Icon name="lucide:moon" id="icon-moon" size={13} />
              <Icon
                name="lucide:sun"
                id="icon-sun"
                size={13}
                style="display:none"
              />
            </button>
          </div>
        </div>
      </header>

      <main id="main-content" class="page" transition:name="page-main">
        <slot />
      </main>

      <footer class="ftr">
        <div class="wrap">
          <div class="ftr-inner">
            <div>
              <a href="/" class="ftr-brand">kraft</a><p class="ftr-note">
                An open lab for curious interfaces.
              </p>
            </div>
            <nav class="ftr-links" aria-label="Footer navigation">
              <a href="/#experiments">Experiments</a><a
                href="https://github.com/fbtwitter/kraft"
                target="_blank"
                rel="noopener noreferrer">GitHub ↗</a
              ><a
                href={PERSONAL_SITE_URL}
                target="_blank"
                rel="noopener noreferrer">Reza Augusdi ↗</a
              >
            </nav>
          </div>
        </div>
      </footer>
    </div>

    <script>
      function applyMode(mode: string) {
        document.documentElement.setAttribute("data-mode", mode);
        const toggle = document.getElementById("mode-toggle");
        const moon = document.getElementById("icon-moon");
        const sun = document.getElementById("icon-sun");
        if (toggle) {
          toggle.setAttribute("aria-pressed", String(mode === "dark"));
          toggle.title =
            mode === "dark" ? "Dark mode is on" : "Dark mode is off";
        }
        if (!moon || !sun) return;
        if (mode === "dark") {
          moon.style.display = "none";
          sun.style.display = "block";
        } else {
          moon.style.display = "block";
          sun.style.display = "none";
        }
      }

      function getMode() {
        return localStorage.getItem("kraft-mode") || "dark";
      }

      document.addEventListener("astro:after-swap", () => {
        document.documentElement.setAttribute("data-mode", getMode());
      });

      document.addEventListener("astro:page-load", () => {
        applyMode(getMode());

        const btn = document.getElementById("mode-toggle");
        if (!btn) return;
        const fresh = btn.cloneNode(true) as HTMLElement;
        btn.replaceWith(fresh);
        fresh.addEventListener("click", () => {
          const next =
            document.documentElement.getAttribute("data-mode") === "dark"
              ? "light"
              : "dark";
          localStorage.setItem("kraft-mode", next);
          applyMode(next);
        });
      });
    </script>

    <script>
      document.addEventListener("astro:before-preparation", () => {
        const bar = document.getElementById("page-progress");
        if (!bar) return;
        bar.classList.remove("done");
        bar.classList.add("loading");
      });
      document.addEventListener("astro:page-load", () => {
        const bar = document.getElementById("page-progress");
        if (!bar) return;
        bar.classList.remove("loading");
        bar.classList.add("done");
        setTimeout(() => bar.classList.remove("done"), 400);
      });
    </script>
  </body>
</html>
