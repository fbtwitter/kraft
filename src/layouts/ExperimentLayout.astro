---
import BaseLayout from "./BaseLayout.astro";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  tags?: string[];
  slug: string;
  githubRepo?: string;
  tipsUrl?: string;
  standaloneUrl?: string;
}

const {
  title,
  description,
  tags = [],
  slug,
  githubRepo = "fbtwitter/kraft",
  tipsUrl,
  standaloneUrl = `/experiments/${slug}/island`,
} = Astro.props;
const feedbackUrl = `https://github.com/${githubRepo}/issues/new?title=${encodeURIComponent(`Feedback: ${title}`)}&body=${encodeURIComponent(`**Experiment:** [${title}](https://kraft-rzaugusdi.vercel.app/experiments/${slug})\n\n**My feedback:**\n`)}`;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  tags={tags}
  includeOutfitFont={slug === "qr-code-card"}
  canonical={`https://kraft-rzaugusdi.vercel.app/experiments/${slug}`}
>
  <div class="wrap pt-8 pb-12 sm:pt-10 sm:pb-16 md:pt-14">
    <a href="/" class="back-link">
      <Icon name="lucide:arrow-left" size={14} aria-hidden="true" />
      all experiments
    </a>

    <div
      class="grid gap-8 pb-9 sm:pb-12 md:grid-cols-[minmax(0,1fr)_minmax(180px,0.45fr)] md:items-end md:gap-12"
    >
      <header>
        <p class="meta mb-3">kraft / experiment</p>
        <h1
          class="display mb-4 text-[clamp(2.5rem,7vw,4.5rem)] leading-[1.02] tracking-[-0.04em]"
        >
          {title}
        </h1>
        <p class="muted max-w-2xl text-base leading-relaxed sm:text-lg">
          {description}
        </p>
      </header>

      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2 md:justify-end">
            {tags.map((tag) => (
              <span class="chip">{tag}</span>
            ))}
          </div>
        )
      }
    </div>

    <nav
      class="mb-10 flex flex-wrap gap-2 border-y border-rule py-3 sm:mb-12"
      aria-label="Experiment actions"
    >
      <a href="#experiment" class="btn primary">
        Try in page
        <span aria-hidden="true">↓</span>
      </a>
      <a
        href={standaloneUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn ghost"
      >
        Open standalone
        <Icon name="lucide:arrow-up-right" size={14} aria-hidden="true" />
      </a>
      <a
        href={feedbackUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn ghost"
      >
        Send feedback
        <Icon name="lucide:arrow-up-right" size={14} aria-hidden="true" />
      </a>
      {
        tipsUrl && (
          <a
            href={tipsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn ghost"
          >
            Tips: how to fix this
            <Icon name="lucide:arrow-up-right" size={14} aria-hidden="true" />
          </a>
        )
      }
    </nav>

    <section
      id="experiment"
      class="scroll-mt-20"
      aria-labelledby="experiment-heading"
    >
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="experiment-heading" class="display text-2xl sm:text-3xl">
          Try the experiment
        </h2>
        <span class="meta">Interactive preview</span>
      </div>
      <div class="experiment-stage">
        <slot />
      </div>
    </section>
  </div>
</BaseLayout>
