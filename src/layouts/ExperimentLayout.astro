---
import BaseLayout from "./BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { createExperimentCatalog } from "../lib/experiment-catalog";

interface Props {
  title: string;
  description: string;
  tags?: string[];
  category: string;
  slug: string;
  githubRepo?: string;
  tipsUrl?: string;
  standaloneUrl?: string;
}

const {
  title,
  description,
  tags = [],
  category,
  slug,
  githubRepo = "fbtwitter/kraft",
  tipsUrl,
  standaloneUrl = `/experiments/${slug}/island`,
} = Astro.props;
const related = createExperimentCatalog(
  await getCollection("experiments"),
).relatedTo(slug);
const feedbackUrl = `https://github.com/${githubRepo}/issues/new?title=${encodeURIComponent(`Feedback: ${title}`)}&body=${encodeURIComponent(`**Experiment:** [${title}](${new URL(`/experiments/${slug}`, Astro.site).href})\n\n**My feedback:**\n`)}`;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  tags={tags}
  includeOutfitFont={slug === "qr-code-card"}
>
  <div class="wrap experiment-page pt-8 pb-12 sm:pt-10 sm:pb-16 md:pt-14">
    <a href="/experiments" class="back-link">
      <Icon name="lucide:arrow-left" size={14} aria-hidden="true" />
      all experiments
    </a>

    <div class="pb-8 sm:pb-10">
      <header>
        <div class="mb-4 flex flex-wrap items-center gap-3">
          <span class="meta">kraft / experiment</span>
          <a
            class="chip"
            href={`/experiments?category=${encodeURIComponent(category)}`}
            >{category}</a
          >
        </div>
        <h1
          class="display mb-4 text-[clamp(2.5rem,7vw,4.5rem)] leading-[1.02] tracking-[-0.04em]"
        >
          {title}
        </h1>
        <p class="muted max-w-2xl text-base leading-relaxed sm:text-lg">
          {description}
        </p>
      </header>
    </div>

    <nav
      class="mb-10 flex flex-wrap gap-2 border-y border-rule py-3 sm:mb-12"
      aria-label="Experiment actions"
    >
      <a href="#experiment" class="btn primary">
        Try in page
        <Icon name="lucide:arrow-down" size={16} aria-hidden="true" />
      </a>
      <a
        href={standaloneUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn ghost"
      >
        Open standalone
        <Icon name="lucide:arrow-up-right" size={14} aria-hidden="true" />
      </a>
      <a
        href={feedbackUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn ghost"
      >
        Send feedback
        <Icon name="lucide:arrow-up-right" size={14} aria-hidden="true" />
      </a>
      {
        tipsUrl && (
          <a
            href={tipsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn ghost"
          >
            Tips: how to fix this
            <Icon name="lucide:arrow-up-right" size={14} aria-hidden="true" />
          </a>
        )
      }
    </nav>

    <section
      id="experiment"
      class="scroll-mt-20"
      aria-labelledby="experiment-heading"
    >
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="experiment-heading" class="display text-2xl sm:text-3xl">
          Try the experiment
        </h2>
        <span class="meta">Interactive preview</span>
      </div>
      <div class="experiment-stage">
        <slot />
      </div>
    </section>
    {
      related.length > 0 && (
        <section
          class="mt-12 border-t border-rule pt-8"
          aria-labelledby="related-heading"
        >
          <h2 id="related-heading" class="display text-2xl">
            More in {category}
          </h2>
          <ul class="mt-6 grid gap-6 sm:grid-cols-2">
            {related.map((experiment) => (
              <li>
                <a
                  href={`/experiments/${experiment.id}`}
                  class="block rounded-lg border border-rule p-5 hover:border-accent"
                >
                  <h3 class="mb-2 text-lg font-medium">
                    {experiment.data.title}
                  </h3>
                  <p class="muted text-sm">{experiment.data.description}</p>
                  <span class="mt-4 inline-flex items-center gap-2 text-sm text-accent">
                    Try experiment{" "}
                    <Icon
                      name="lucide:arrow-right"
                      size={16}
                      aria-hidden="true"
                    />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
