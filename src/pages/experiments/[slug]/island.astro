---
import { getCollection, render } from "astro:content";
import { Font } from "astro:assets";
import { createExperimentCatalog } from "../../../lib/experiment-catalog";
import LabAppearance from "../../../components/LabAppearance.astro";
import "../../../styles/global.css";
import "../../../styles/forms.css";

export async function getStaticPaths() {
  const { experiments } = createExperimentCatalog(
    await getCollection("experiments"),
  );
  return experiments.map((exp) => ({
    params: { slug: exp.id },
    props: { exp },
  }));
}

const { exp } = Astro.props;
const { Content } = await render(exp);
---

<!doctype html>
<html lang="en" data-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{exp.data.title} · island</title>
    {
      exp.data.usesKraftFonts && (
        <>
          <Font cssVariable="--font-display" preload />
          <Font cssVariable="--font-body" preload />
          <Font cssVariable="--font-mono" preload />
        </>
      )
    }
    <LabAppearance />
  </head>
  <body
    class="standalone-experiment flex min-h-dvh items-center justify-center p-4 sm:p-8"
  >
    <Content />
  </body>
</html>
