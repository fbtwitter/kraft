---
import { getCollection, render } from "astro:content";
import ExperimentLayout from "../../../layouts/ExperimentLayout.astro";
import { createExperimentCatalog } from "../../../lib/experiment-catalog";

export async function getStaticPaths() {
  const { experiments } = createExperimentCatalog(
    await getCollection("experiments"),
  );
  return experiments.map((exp) => ({
    params: { slug: exp.id },
    props: { exp },
  }));
}

const { exp } = Astro.props;
const { Content } = await render(exp);
---

<ExperimentLayout
  title={exp.data.title}
  description={exp.data.description}
  tags={exp.data.tags}
  category={exp.data.category}
  slug={exp.id}
  tipsUrl={exp.data.tipsUrl}
  standaloneUrl={exp.data.standaloneUrl}
>
  <Content />
</ExperimentLayout>
