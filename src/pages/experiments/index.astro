---
import { Icon } from "astro-icon/components";
import CollectionFilters from "../../components/CollectionFilters.astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createExperimentCatalog } from "../../lib/experiment-catalog";
const { experiments, categories } = createExperimentCatalog(
  await getCollection("experiments"),
);
---

<BaseLayout
  title="Experiments"
  description="Browse Kraft’s live experiments in interfaces and interaction."
>
  <div class="wrap listing">
    <header>
      <p class="meta">Kraft / the collection</p>
      <h1 class="display">Experiments</h1>
      <p class="muted">
        Small ideas you can try. Pick an experiment and see how it works.
      </p>
    </header>
    <CollectionFilters categories={categories} />
    <p class="meta filter-count" role="status" id="experiment-results">
      {experiments.length} experiments
    </p>
    <p id="experiment-empty" class="muted" hidden>
      No experiments match. Try another word or clear your filters.
    </p>
    {
      categories.map((category) => (
        <section class="category-group" aria-label={category}>
          <h2 class="category-heading">{category}</h2>
          <div class="listing-grid">
            {experiments
              .filter((exp) => exp.data.category === category)
              .map((exp) => (
                <a
                  class="listing-card"
                  href={`/experiments/${exp.id}`}
                  data-search={`${exp.data.title} ${exp.data.description} ${exp.data.tags.join(" ")}`.toLowerCase()}
                  data-tags={exp.data.tags.join(" ")}
                  data-category={exp.data.category}
                >
                  <div class="listing-copy">
                    <h3>{exp.data.title}</h3>
                    <p class="muted">{exp.data.description}</p>
                    <span class="action">
                      Try experiment{" "}
                      <Icon
                        name="lucide:arrow-up-right"
                        size={16}
                        aria-hidden="true"
                      />
                    </span>
                  </div>
                </a>
              ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
<style>
  .filter-count {
    margin-bottom: 24px;
  }
  .category-group {
    margin-bottom: 40px;
  }
  .category-heading {
    margin: 0 0 20px;
    font-size: 1.25rem;
  }
  .listing-card[hidden],
  [hidden] {
    display: none !important;
  }
  .listing {
    padding-block: 64px 96px;
  }
  header {
    max-width: 680px;
    margin-bottom: 48px;
  }
  h1 {
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    margin: 16px 0 24px;
  }
  .listing-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .listing-card {
    min-height: 220px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
    display: flex;
    flex-direction: column;
  }
  .listing-card:hover {
    border-color: var(--accent);
  }
  img {
    width: 100%;
    height: 240px;
    object-fit: contain;
    background: var(--bg-2);
    border-bottom: 1px solid var(--rule);
  }
  .listing-copy {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    align-items: flex-start;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .listing-copy h3 {
    font-size: 1.5rem;
    font-weight: 500;
    margin: 0 0 12px;
    letter-spacing: -0.035em;
  }
  .listing-copy p {
    margin: 0 0 24px;
    line-height: 1.75;
  }
  .action {
    color: var(--accent);
    font-size: 0.875rem;
    margin-top: auto;
  }
  @media (max-width: 650px) {
    .listing-grid {
      grid-template-columns: 1fr;
    }
    .listing {
      padding-block: 40px 64px;
    }
    img {
      height: 200px;
    }
  }
</style>
