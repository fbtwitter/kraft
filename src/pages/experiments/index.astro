---
import { Icon } from "astro-icon/components";
import TopicSelect from "../../components/TopicSelect.astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const experiments = (
  await getCollection("experiments", ({ data }) => !data.draft)
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const categories = [
  ...new Set(experiments.map((exp) => exp.data.category)),
].sort();
---

<BaseLayout
  title="Experiments"
  description="Browse Kraft’s live experiments in interfaces and interaction."
>
  <div class="wrap listing">
    <header>
      <p class="meta">Kraft / the collection</p>
      <h1 class="display">Experiments</h1>
      <p class="muted">
        Small ideas you can try. Pick an experiment and see how it works.
      </p>
    </header>
    <form
      class="collection-filters"
      role="search"
      aria-label="Filter experiments"
      onsubmit="return false"
    >
      <label
        >Find an experiment<input
          type="search"
          id="experiment-query"
          placeholder="Search titles, descriptions, or tags"
        /></label
      >
      <label
        >Category<TopicSelect
          ><select id="experiment-topic" aria-label="Category"
            ><option value="">All categories</option>{
              categories.map((category) => (
                <option value={category}>{category}</option>
              ))
            }</select
          ></TopicSelect
        ></label
      >
      <button type="reset" class="btn ghost">Clear filters</button>
    </form>
    <p class="meta filter-count" role="status" id="experiment-results">
      {experiments.length} experiments
    </p>
    <p id="experiment-empty" class="muted" hidden>
      No experiments match. Try another word or clear your filters.
    </p>
    {
      categories.map((category) => (
        <section class="category-group" aria-label={category}>
          <h2 class="category-heading">{category}</h2>
          <div class="listing-grid">
            {experiments
              .filter((exp) => exp.data.category === category)
              .map((exp) => (
                <a
                  class="listing-card"
                  href={`/experiments/${exp.id}`}
                  data-search={`${exp.data.title} ${exp.data.description} ${exp.data.tags.join(" ")}`.toLowerCase()}
                  data-tags={exp.data.tags.join(" ")}
                  data-category={exp.data.category}
                >
                  <div class="listing-copy">
                    <h2>{exp.data.title}</h2>
                    <p class="muted">{exp.data.description}</p>
                    <span class="action">
                      Try experiment{" "}
                      <Icon
                        name="lucide:arrow-up-right"
                        size={16}
                        aria-hidden="true"
                      />
                    </span>
                  </div>
                </a>
              ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
<script>
  document.addEventListener("astro:page-load", () => {
    const query = document.querySelector<HTMLInputElement>("#experiment-query");
    const topic =
      document.querySelector<HTMLSelectElement>("#experiment-topic");
    const form = document.querySelector<HTMLFormElement>(".collection-filters");
    if (!query || !topic || !form) return;
    const controller = new AbortController();
    const cards = [...document.querySelectorAll<HTMLElement>(".listing-card")];
    const params = new URLSearchParams(location.search);
    query.value = params.get("q") || "";
    const initial = params.get("category") || params.get("topic") || "";
    topic.value = [...topic.options].some((option) => option.value === initial)
      ? initial
      : cards.find((card) => card.dataset.tags!.split(" ").includes(initial))
          ?.dataset.category || "";
    function filter() {
      const text = query!.value.trim().toLowerCase();
      let count = 0;
      for (const card of cards) {
        card.hidden = !(
          card.dataset.search!.includes(text) &&
          (!topic!.value || card.dataset.category === topic!.value)
        );
        if (!card.hidden) count++;
      }
      document.getElementById("experiment-results")!.textContent =
        `${count} ${count === 1 ? "experiment" : "experiments"}`;
      document.getElementById("experiment-empty")!.hidden = count > 0;
      document
        .querySelectorAll<HTMLElement>(".category-group")
        .forEach((group) => {
          group.hidden = !group.querySelector(".listing-card:not([hidden])");
        });
      const url = new URL(location.href);
      text
        ? url.searchParams.set("q", query!.value)
        : url.searchParams.delete("q");
      topic!.value
        ? url.searchParams.set("category", topic!.value)
        : url.searchParams.delete("category");
      url.searchParams.delete("topic");
      history.replaceState(history.state, "", url);
    }
    query.addEventListener("input", filter, { signal: controller.signal });
    topic.addEventListener("change", filter, { signal: controller.signal });
    form.addEventListener(
      "reset",
      () => {
        query.value = "";
        topic.value = "";
        filter();
      },
      { signal: controller.signal },
    );
    filter();
    topic.dispatchEvent(new Event("change", { bubbles: true }));
    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
    });
  });
</script>
<style>
  .collection-filters {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 240px) auto;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 20px;
    padding: 24px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--surface);
  }
  .collection-filters label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.875rem;
    flex: 1 1 240px;
  }
  .collection-filters label:nth-child(2) {
    flex: 0 1 200px;
  }
  .collection-filters label {
    max-width: none;
    min-width: 0;
    color: var(--ink-2);
  }
  .collection-filters .btn {
    min-height: 46px;
    white-space: nowrap;
  }
  .collection-filters input,
  .collection-filters select {
    width: 100%;
    max-width: none;
    min-height: 46px;
    padding: 10px 12px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }
  .filter-count {
    margin-bottom: 24px;
  }
  .category-group {
    margin-bottom: 40px;
  }
  .category-heading {
    margin: 0 0 20px;
    font-size: 1.25rem;
  }
  .listing-card[hidden],
  [hidden] {
    display: none !important;
  }
  .listing {
    padding-block: 64px 96px;
  }
  header {
    max-width: 680px;
    margin-bottom: 48px;
  }
  h1 {
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    margin: 16px 0 24px;
  }
  .listing-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .listing-card {
    min-height: 220px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
    display: flex;
    flex-direction: column;
  }
  .listing-card:hover {
    border-color: var(--accent);
  }
  img {
    width: 100%;
    height: 240px;
    object-fit: contain;
    background: var(--bg-2);
    border-bottom: 1px solid var(--rule);
  }
  .listing-copy {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    align-items: flex-start;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  h2 {
    font-size: 1.5rem;
    font-weight: 500;
    margin: 0 0 12px;
    letter-spacing: -0.035em;
  }
  .listing-copy p {
    margin: 0 0 24px;
    line-height: 1.75;
  }
  .action {
    color: var(--accent);
    font-size: 0.875rem;
    margin-top: auto;
  }
  @media (max-width: 650px) {
    .collection-filters {
      grid-template-columns: minmax(0, 1fr);
      padding: 20px;
    }
    .listing-grid {
      grid-template-columns: 1fr;
    }
    .listing {
      padding-block: 40px 64px;
    }
    img {
      height: 200px;
    }
  }
</style>
