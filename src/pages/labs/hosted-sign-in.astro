---
import MockLoginChild from "../../islands/MockLoginChild.tsx";
import "../../styles/island.css";

const actions = [
  {
    key: "redirect",
    label: "Redirect",
    lines: [
      "→ navigating the top-level window to a hosted sign-in page (simulated)",
      "✓ starts inside a frame, but the full page leaves to complete sign-in",
    ],
  },
  {
    key: "popup",
    label: "Popup",
    lines: [
      "→ opening a hosted sign-in page in a new window (simulated)",
      "✓ continues in a popup with its own browsing context",
    ],
  },
  {
    key: "silent",
    label: "Silent (iframe)",
    lines: [
      "→ prompt=none request via hidden iframe (simulated)",
      "✓ requires an active session; otherwise it returns no result",
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>sample hosted sign-in · kraft</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="flex min-h-dvh items-center justify-center p-8">
    <MockLoginChild
      client:load
      subtitle="sample sign-in · hosted flow"
      actions={actions}
    />
  </body>
</html>
