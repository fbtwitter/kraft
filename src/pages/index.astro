---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import KraftSculpture from "../components/KraftSculpture.astro";
const experiments = (
  await getCollection("experiments", ({ data }) => !data.draft)
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = experiments[0];
const moreExperiments = experiments.slice(1);
const countLabel = (count: number) => String(count).padStart(2, "0");
const dateLabel = (date: Date) =>
  date.toLocaleDateString("en", { month: "short", year: "numeric" });
---

<BaseLayout title="kraft">
  <section class="wrap lab-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="meta hero-eyebrow">An independent interface lab</p>
      <h1 id="home-title" class="display">
        Good ideas<br />get better<br />when you play.
      </h1>
      <p class="hero-description">
        Small experiments in interfaces and interaction. Open one, change
        something, and see what happens.
      </p>
      <div class="hero-actions">
        <a href="#experiments" class="btn primary"
          >Explore experiments <span aria-hidden="true">↘</span></a
        >
        <a
          href="https://github.com/fbtwitter/kraft"
          class="btn ghost"
          target="_blank"
          rel="noopener noreferrer"
          >View source <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
    <KraftSculpture />
  </section>
  <section
    id="experiments"
    class="lab-feature"
    aria-labelledby="featured-title"
  >
    <div class="wrap">
      <div class="section-topline">
        <p class="meta">Inside the lab</p><span class="meta"
          >{countLabel(experiments.length)} experiments to explore</span
        >
      </div>
      {
        featured ? (
          <a
            href={`/experiments/${featured.id}`}
            aria-label={`Try ${featured.data.title}`}
            class="idx-row featured-experiment"
          >
            <div class="featured-copy">
              <>
                <p class="meta">Featured experiment</p>
                <h2 id="featured-title" class="display">
                  {featured.data.title}
                </h2>
              </>
              <p class="experiment-description">{featured.data.description}</p>
              <div class="experiment-tags">
                {featured.data.tags.slice(0, 3).map((tag: string) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
              <span class="experiment-action">
                Try experiment <span aria-hidden="true">↗</span>
              </span>
            </div>
            <div class="featured-preview">
              <div class="preview-bar">
                <>
                  <span class="preview-dot" />
                  <span>Live experiment</span>
                  <time datetime={featured.data.publishedAt.toISOString()}>
                    {dateLabel(featured.data.publishedAt)}
                  </time>
                </>
              </div>
              {featured.data.preview ? (
                <img
                  src={featured.data.preview}
                  alt=""
                  loading="eager"
                  decoding="async"
                />
              ) : (
                <span class="meta preview-empty">Open to explore</span>
              )}
            </div>
          </a>
        ) : (
          <p id="featured-title" class="muted">
            The lab is getting ready. Check back soon.
          </p>
        )
      }
    </div>
  </section>
  {
    moreExperiments.length > 0 && (
      <section class="wrap catalog-section" aria-labelledby="more-title">
        <div class="catalog-intro">
          <>
            <p class="meta">Keep exploring</p>
            <h2 id="more-title" class="display">
              Something else
              <br /> to play with.
            </h2>
          </>
          <>
            <p>
              Different questions.
              <br />A few ways to try them out.
            </p>
            <span class="catalog-count mono">
              {countLabel(moreExperiments.length)} more experiments{" "}
              <span aria-hidden="true">↗</span>
            </span>
          </>
        </div>
        <div class="experiment-list">
          {moreExperiments.map((exp) => (
            <a
              href={`/experiments/${exp.id}`}
              aria-label={`Try ${exp.data.title}`}
              class="idx-row experiment-card"
            >
              <div class="experiment-card-copy">
                <div class="experiment-card-meta">
                  <span>{exp.data.tags[0] ?? "experiment"}</span>
                  <time datetime={exp.data.publishedAt.toISOString()}>
                    {dateLabel(exp.data.publishedAt)}
                  </time>
                </div>
                <h3>{exp.data.title}</h3>
                <p>{exp.data.description}</p>
                <span class="experiment-action">
                  Try experiment <span aria-hidden="true">→</span>
                </span>
              </div>
              <div class="experiment-card-preview">
                {exp.data.preview ? (
                  <img
                    src={exp.data.preview}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="meta">Open to explore</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
<style>
  .lab-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 72px;
    padding-block: clamp(88px, 10vw, 152px) clamp(96px, 11vw, 160px);
  }
  .hero-eyebrow {
    margin: 0 0 28px;
  }
  .hero-copy h1 {
    margin: 0;
    font-size: clamp(3rem, 5.8vw, 5.25rem);
    line-height: 1.03;
  }
  .hero-description {
    max-width: 460px;
    margin: 28px 0 0;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--ink-2);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }
  .lab-feature {
    border-block: 1px solid var(--rule);
    padding-block: 52px 88px;
  }
  .section-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 48px;
  }
  .section-topline p {
    margin: 0;
  }
  .featured-experiment {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 72px;
    align-items: center;
  }
  .featured-copy h2 {
    font-size: clamp(2.25rem, 4.1vw, 3.5rem);
    margin: 16px 0 22px;
  }
  .experiment-description {
    margin: 0;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.75;
    max-width: 430px;
  }
  .experiment-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0 28px;
  }
  .experiment-action {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .featured-preview {
    overflow: hidden;
    min-width: 0;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--surface);
  }
  .preview-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 13px 16px;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .preview-bar time {
    margin-left: auto;
    color: var(--ink-3);
  }
  .preview-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .featured-preview img {
    display: block;
    width: 100%;
    height: clamp(260px, 28vw, 370px);
    object-fit: contain;
    background: var(--bg-2);
  }
  .preview-empty {
    display: grid;
    place-items: center;
    min-height: 280px;
  }
  .featured-experiment:hover h2,
  .featured-experiment:focus-visible h2 {
    color: var(--accent);
  }
  .catalog-section {
    display: grid;
    grid-template-columns: minmax(0, 0.65fr) minmax(0, 1fr);
    gap: 88px;
    padding-block: 104px 120px;
  }
  .catalog-intro .meta {
    margin: 0 0 24px;
  }
  .catalog-intro h2 {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    margin: 0 0 24px;
  }
  .catalog-intro > p:not(.meta) {
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.75;
  }
  .catalog-count {
    display: block;
    color: var(--ink-3);
    font-size: 0.8125rem;
    margin-top: 32px;
  }
  .experiment-list {
    display: grid;
    gap: 20px;
  }
  .experiment-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 160px;
    gap: 24px;
    align-items: center;
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 24px;
    background: var(--surface);
  }
  .experiment-card:hover,
  .experiment-card:focus-visible {
    border-color: var(--ink-3);
  }
  .experiment-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .experiment-card-meta > span {
    color: var(--accent);
  }
  .experiment-card h3 {
    margin: 0 0 10px;
    font-size: 1.25rem;
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  .experiment-card p {
    color: var(--ink-2);
    font-size: 0.875rem;
    line-height: 1.7;
    margin: 0 0 20px;
  }
  .experiment-card-preview {
    min-width: 0;
  }
  .experiment-card-preview img {
    display: block;
    width: 100%;
    height: 140px;
    object-fit: cover;
    border-radius: 6px;
  }
  @media (max-width: 1000px) {
    .lab-hero,
    .featured-experiment {
      gap: 40px;
    }
  }
  @media (max-width: 700px) {
    .lab-hero {
      grid-template-columns: 1fr;
      gap: 20px;
      padding-block: 56px 64px;
    }
    .hero-copy h1 {
      font-size: clamp(2.75rem, 10.2vw, 4.25rem);
    }
    .hero-eyebrow {
      margin-bottom: 22px;
    }
    .hero-actions .btn {
      padding-inline: 12px;
    }
    .lab-feature {
      padding-block: 32px 56px;
    }
    .section-topline {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 32px;
    }
    .featured-experiment {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .featured-preview img {
      height: 260px;
    }
    .catalog-section {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 64px 72px;
    }
    .catalog-intro h2 br {
      display: none;
    }
    .catalog-intro .meta {
      margin-bottom: 16px;
    }
    .catalog-intro > p:not(.meta) {
      margin-bottom: 0;
    }
    .catalog-count {
      margin-top: 20px;
    }
    .experiment-card {
      grid-template-columns: minmax(0, 1fr) 96px;
      gap: 16px;
    }
    .experiment-card-preview img {
      height: 104px;
    }
  }
  @media (max-width: 360px) {
    .experiment-card {
      grid-template-columns: 1fr;
    }
    .experiment-card-preview {
      order: -1;
    }
    .experiment-card-preview img {
      height: 150px;
      object-fit: contain;
      background: var(--bg-2);
    }
  }
</style>
